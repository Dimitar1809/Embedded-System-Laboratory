	component soc_system is
		port (
			clk_clk                            : in    std_logic                     := 'X';             -- clk
			hps_0_h2f_reset_reset_n            : out   std_logic;                                        -- reset_n
			memory_mem_a                       : out   std_logic_vector(14 downto 0);                    -- mem_a
			memory_mem_ba                      : out   std_logic_vector(2 downto 0);                     -- mem_ba
			memory_mem_ck                      : out   std_logic;                                        -- mem_ck
			memory_mem_ck_n                    : out   std_logic;                                        -- mem_ck_n
			memory_mem_cke                     : out   std_logic;                                        -- mem_cke
			memory_mem_cs_n                    : out   std_logic;                                        -- mem_cs_n
			memory_mem_ras_n                   : out   std_logic;                                        -- mem_ras_n
			memory_mem_cas_n                   : out   std_logic;                                        -- mem_cas_n
			memory_mem_we_n                    : out   std_logic;                                        -- mem_we_n
			memory_mem_reset_n                 : out   std_logic;                                        -- mem_reset_n
			memory_mem_dq                      : inout std_logic_vector(31 downto 0) := (others => 'X'); -- mem_dq
			memory_mem_dqs                     : inout std_logic_vector(3 downto 0)  := (others => 'X'); -- mem_dqs
			memory_mem_dqs_n                   : inout std_logic_vector(3 downto 0)  := (others => 'X'); -- mem_dqs_n
			memory_mem_odt                     : out   std_logic;                                        -- mem_odt
			memory_mem_dm                      : out   std_logic_vector(3 downto 0);                     -- mem_dm
			memory_oct_rzqin                   : in    std_logic                     := 'X';             -- oct_rzqin
			quad_comm_0_pitch_channel_a_signal : in    std_logic                     := 'X';             -- signal
			quad_comm_0_pitch_channel_b_signal : in    std_logic                     := 'X';             -- signal
			quad_comm_0_slave_address          : in    std_logic_vector(7 downto 0)  := (others => 'X'); -- address
			quad_comm_0_slave_read             : in    std_logic                     := 'X';             -- read
			quad_comm_0_slave_readdata         : out   std_logic_vector(31 downto 0);                    -- readdata
			quad_comm_0_slave_write            : in    std_logic                     := 'X';             -- write
			quad_comm_0_slave_writedata        : in    std_logic_vector(31 downto 0) := (others => 'X'); -- writedata
			quad_comm_0_slave_byteenable       : in    std_logic_vector(3 downto 0)  := (others => 'X'); -- byteenable
			quad_comm_0_yaw_channel_a_signal   : in    std_logic                     := 'X';             -- signal
			quad_comm_0_yaw_channel_b_signal   : in    std_logic                     := 'X';             -- signal
			reset_reset_n                      : in    std_logic                     := 'X'              -- reset_n
		);
	end component soc_system;

